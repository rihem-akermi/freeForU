generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model agents {
  id                   Int                   @id @default(autoincrement())
  name                 String                @db.VarChar(255)
  phone                String?               @db.VarChar(255)
  password             String                @db.VarChar(255)
  ville                String?               @db.VarChar(255)
  role                 String                @default("AGENT") @db.VarChar(20)
  email                String?               @db.VarChar(255)
  category_id          Int?
  photo_url            String?               @db.VarChar(255)
  bio                  String?
  zone                 String?               @db.VarChar(150)
  service_mode         String?               @db.VarChar(20)
  age                  Int?
  sexe                 String?               @db.VarChar(10)
  experience_years     Int?
  social_links         Json?
  id_card_url          String?               @db.VarChar(255)
  work_certificate_url String?               @db.VarChar(255)
  verification_status  String?               @default("non_verifie") @db.VarChar(20)
  agent_blocked_slots  agent_blocked_slots[]
  agent_working_hours  agent_working_hours[]
  categories           categories?           @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  publications         publications[]
  reservations         reservations[]
  reviews              reviews[]
  services             services[]
}

model categories {
  id     Int      @id @default(autoincrement())
  name   String   @unique(map: "categories_nom_key") @db.VarChar(100)
  agents agents[]
}

model contacts {
  idcontact  Int       @id @default(autoincrement())
  name       String    @db.VarChar(255)
  email      String    @db.VarChar(255)
  message    String
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model publications {
  id          Int       @id @default(autoincrement())
  agent_id    Int
  photo_url   String?   @db.VarChar(255)
  description String
  status      String?   @default("en_attente") @db.VarChar(20)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  titre       String?   @db.VarChar(150)
  likes_count Int       @default(0)
  saved_count Int       @default(0)
  agents      agents    @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reservations {
  id                    Int       @id @default(autoincrement())
  client_id             Int
  agent_id              Int
  date_reservation      DateTime  @db.Date
  status                String    @default("en_attente") @db.VarChar(20)
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  agent_confirmed       Boolean   @default(false)
  client_confirmed      Boolean   @default(false)
  heure_reservation     DateTime? @db.Time(6)
  custom_request        String?
  heure_fin_reservation DateTime? @db.Time(6)
  archived              Boolean   @default(false)
  service_id            Int?
  service_nom           String?   @db.VarChar(150)
  service_prix          Float?
  updated_at            DateTime? @updatedAt @db.Timestamp(6)
  reminder_sent         Boolean   @default(false)
  agents                agents    @relation(fields: [agent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                 users     @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  services              services? @relation(fields: [service_id], references: [id], onUpdate: NoAction)
  reviews               reviews?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  id             Int          @id @default(autoincrement())
  agent_id       Int
  reservation_id Int          @unique
  client_id      Int
  rating         Int?
  comment        String?
  created_at     DateTime     @default(now()) @db.Timestamp(6)
  agents         agents       @relation(fields: [agent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users          users        @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reservations   reservations @relation(fields: [reservation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([agent_id], map: "idx_reviews_agent_id")
}

model users {
  id           Int            @id @default(autoincrement())
  name         String         @db.VarChar(255)
  email        String         @unique @db.VarChar(255)
  password     String         @db.VarChar(255)
  role         String         @default("CLIENT") @db.VarChar(20)
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  ville        String?        @db.VarChar(100)
  phone        String?        @db.VarChar(20)
  photo_url    String?        @db.VarChar(255)
  reservations reservations[]
  reviews      reviews[]
}

model agent_working_hours {
  id          Int       @id @default(autoincrement())
  agent_id    Int
  day_of_week Int
  start_time  DateTime? @db.Time(6)
  end_time    DateTime? @db.Time(6)
  is_working  Boolean   @default(true)
  agents      agents    @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([agent_id, day_of_week])
}

model agent_blocked_slots {
  id       Int      @id @default(autoincrement())
  agent_id Int
  date     DateTime @db.Date
  reason   String?  @db.VarChar(255)
  type     String   @default("off") @db.VarChar(10)
  agents   agents   @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([agent_id, date])
}

model services {
  id            Int            @id @default(autoincrement())
  agent_id      Int
  nom           String         @db.VarChar(150)
  description   String?
  type_prix     String         @default("fixe") @db.VarChar(20)
  prix          Float
  duree_estimee Int?
  created_at    DateTime?      @default(now()) @db.Timestamp(6)
  reservations  reservations[]
  agents        agents         @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
